rules_version = '2';

// =====================================================================
// REHOTEQ Field — Firestore security rules
//
// These rules ARE the product's security. The Firebase web config is
// public by design — it ships in the browser — so once it is out there,
// anyone can write a script against this database. The only thing
// standing between a stranger and every customer's name, phone number
// and home address is this file.
//
// Read it as a contract, not boilerplate.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---- helpers ---------------------------------------------------- */

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function memberDoc(companyId, uid) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(uid)).data;
    }
    function isMember(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }
    // Owner accounts (kept in sync with OWNER_EMAILS in functions/index.js).
    // The owner may read the account register to run Field HQ; they still
    // get no customer jobs, which carry the private data.
    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && (request.auth.token.email.toLowerCase() == 'rehoteq@gmail.com'
            || request.auth.token.email.toLowerCase() == 'rehoteq1@gmail.com');
    }

    function isLeadOf(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid))
        && memberDoc(companyId, request.auth.uid).role == 'lead';
    }

    // Fields only a server may write. If the client could set `plan`, the
    // paywall would be a lie again — the whole point of moving to a server
    // was that the technician does not get to decide whether he has paid.
    function entitlementKeys() {
      return ['plan', 'trialEndsAt', 'expiresAt', 'entitlementSource', 'lastPaymentRef'].toSet();
    }
    function touchesEntitlement() {
      return request.resource.data.diff(resource.data)
               .affectedKeys().hasAny(entitlementKeys());
    }

    /* ---- user accounts ---------------------------------------------- */

    match /users/{uid} {
      // You may read your own account. The owner may read the register
      // (name, email, plan, activity) to run Field HQ. Nobody else reads
      // anyone else's record.
      allow read: if isSelf(uid) || isOwner();

      // The account record is created by a Cloud Function the moment a user
      // first signs in, so the 14-day trial clock is set by the server and
      // not by the device. The client never creates it.
      allow create: if false;

      // You may edit your own profile — name, phone, company, logo.
      // You may not edit what you are entitled to.
      allow update: if isSelf(uid) && !touchesEntitlement();

      allow delete: if false;
    }

    /* ---- cloud backup index (v1.9.0) --------------------------------- */

    // One small document per account, sitting next to the backup bundle
    // in Storage: when it was taken, how many jobs, how many photos, how
    // big. It is the index the boot screen reads to say "a backup from
    // 12 Oct is waiting" — reading it must not cost a 200 MB download.
    //
    // It carries no job data and no customer data: the bundle does, and
    // the bundle is behind the storage rules. This document is a label.
    match /backups/{uid} {
      allow read: if isSelf(uid);

      // You write your own label, and only your own, and it may contain
      // nothing but these fields — so this document can never be turned
      // into a second, unguarded copy of the register.
      allow create, update: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'email', 'jobs', 'photos', 'bytes', 'path', 'appVersion', 'updatedAt'])
        && request.resource.data.bytes is int
        && request.resource.data.jobs is int
        && request.resource.data.photos is int
        && request.resource.data.bytes >= 0;

      // Deleting your own backup is your right — that is what "delete my
      // data" has to mean.
      allow delete: if isSelf(uid);
    }

    /* ---- companies (the Business plan unit) -------------------------- */

    match /companies/{companyId} {
      // Only members see a company at all.
      allow read: if isMember(companyId);

      // Any signed-in user may start a company. They become its first lead
      // because the client writes the owner as itself — enforced below.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // Only a lead may change the company's name, address or bio.
      allow update, delete: if isLeadOf(companyId);

      match /members/{memberUid} {
        // Members see each other. Outsiders see nothing.
        allow read: if isMember(companyId);

        // A lead adds technicians and sets their role. Nobody else does.
        allow create, update: if isLeadOf(companyId);

        // A lead may remove a technician. A technician may remove
        // themselves — that is how someone leaves.
        allow delete: if isLeadOf(companyId) || isSelf(memberUid);
      }
    }

    /* ---- jobs -------------------------------------------------------- */

    // The crew shares the work: any member of the job's company may read
    // it, so a job pushed live from a technician's phone reaches the
    // lead's phone too. Writes stay where they were: owner or assignee.

    // Job records carry customer names, phone numbers and home addresses.
    // A leak here is a data-protection problem, not an inconvenience.
    match /jobs/{jobId} {
      function owns()      { return resource.data.ownerId == request.auth.uid; }
      function assigned()  { return resource.data.assignedTo == request.auth.uid; }

      allow read: if signedIn() && (
          owns()
          || assigned()
          || (resource.data.companyId != null && isMember(resource.data.companyId))
        );

      // You may only create a job that belongs to you.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // The owner and the technician sent to the job may both update it.
      // A technician must not be able to reassign it to someone else.
      allow update: if signedIn() && (owns() || assigned())
        && request.resource.data.ownerId == resource.data.ownerId;

      // Only the owner deletes. Evidence does not quietly disappear.
      allow delete: if signedIn() && owns();
    }

    /* ---- AI diagnosis audit log (written by aiProxy only) ------------ */

    // Every diagnosis call is logged by the aiProxy Cloud Function for
    // safety auditing and the V3 training flywheel. Clients never write
    // or alter log rows directly — only the server does. A signed-in
    // technician may read their own log entries and no one else's.
    match /ai_requests/{requestId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    /* ---- internal feedback ------------------------------------------- */

    // The in-app feedback box. Any signed-in technician may send a note
    // to HQ; only the owner may read them. Text is capped here, not just
    // client-side.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.keys().hasOnly(['uid', 'email', 'text', 'createdAt']);
      allow read, update, delete: if isOwner();
    }

    /* ---- everything else -------------------------------------------- */

    // Default deny. A new collection is invisible until someone writes a
    // rule for it on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

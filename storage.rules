rules_version = '2';

// =====================================================================
// REHOTEQ Field — Cloud Storage security rules
//
// Holds the photo evidence: before / during / after / serial.
//
// Deliberate design choice: photos are stored under the owning user's
// uid, not under a shared company path. That makes this file trivially
// simple and obviously correct.
//
// The alternative — a shared company path with a Firestore lookup to
// decide access — is cleverer and has more places to be wrong. Simple
// rules with no holes beat clever rules with one.
//
// Company-wide photo sharing, when it is needed, gets its own designed
// path. It does not happen by accident here.
// =====================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // users/{uid}/jobs/{jobId}/{photoId}.jpg
    //
    // You may read and write the photos you own. Nothing else.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        // An evidence photo is a few MB. Hard cap it so a bug or a
        // malicious client cannot fill the bucket with one upload.
        && request.resource.size < 12 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // users/{uid}/cloud-backup/latest.zip
    //
    // The v1.9.0 cloud backup: one zip holding the job cards, the photos,
    // the company profile and the crew record.
    //
    // The rule above (users/{uid}/{allPaths=**}) deliberately refuses it —
    // 12 MB and image/* is what an evidence photo is, and a backup is
    // neither. This block is the deliberate second decision: same owner
    // gate, one file per account, a 500 MB ceiling so a bug or a hostile
    // client cannot fill the bucket, and a content type that must be the
    // zip we wrote. Storage grants access if ANY matching rule allows it,
    // so nothing above is widened by this.
    match /users/{uid}/cloud-backup/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType == 'application/zip';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny for everything not explicitly above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
